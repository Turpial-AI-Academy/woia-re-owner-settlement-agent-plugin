{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External owner-settlement source version",
  "type": "object",
  "required": [
    "system",
    "account",
    "externalSettlementId",
    "sourceVersion",
    "beneficiary",
    "property",
    "mandate",
    "period",
    "currency",
    "document"
  ],
  "additionalProperties": false,
  "properties": {
    "system": {
      "type": "string",
      "minLength": 1
    },
    "account": {
      "type": "string",
      "minLength": 1
    },
    "externalSettlementId": {
      "type": "string",
      "minLength": 1
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "beneficiary": {
      "type": "string",
      "minLength": 1
    },
    "property": {
      "type": "string",
      "minLength": 1
    },
    "mandate": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "minLength": 1
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "state",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "const": "USABLE"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
